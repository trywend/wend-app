# Wend app — env template. Copy to .env.local and fill in.

# Shared Neon DB (same instance as the landing; app tables only).
DATABASE_URL=

# Google OAuth — SERVER-ONLY (never prefix with EXPO_PUBLIC_).
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Client-visible (inlined into the app bundle).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_ENABLED=false
